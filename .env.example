# Set to 1 behind HTTPS in production; leave at 0 for local development.
DAYMARK_COOKIE_SECURE=0

# Gemini mode uses the free tier when available; see README for its data terms.
SUMMARY_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional local-only mode: SUMMARY_MODE=mock

# Optional legacy OpenAI mode. Never commit or share API keys.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5

# Sign-in provider settings (leave blank until credentials are created).
DAYMARK_OAUTH_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional location for the SQLite database.
# DAYMARK_DB_PATH=/path/to/daymark.sqlite3

# Required for background web push. Generate a VAPID key pair and keep the private key on the server.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=/path/to/vapid_private.pem
VAPID_SUBJECT=mailto:admin@example.com

DAYMARK_SESSION_DAYS=90
# Passkeys require HTTPS on phones. RP ID is the site hostname without scheme or port.
DAYMARK_WEBAUTHN_RP_ID=
# Optional origin override when running behind an HTTPS reverse proxy.
DAYMARK_WEBAUTHN_ORIGIN=
